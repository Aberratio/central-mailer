APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_CORS_ORIGIN=*
APP_MAX_REQUEST_BODY_BYTES=12000000
APP_DOCS_ENABLED=true
APP_DOCS_PUBLIC=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=central_mailer
DB_USERNAME=root
DB_PASSWORD=secret
DATABASE_DUMP_BIN=

API_KEY_APP_A=change-me-app-a
API_KEY_APP_B=change-me-app-b
ADMIN_API_KEY=change-me-admin-key-at-least-32-chars

SMTP_HOST=h18.seohost.pl
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=kontakt@example.com
SMTP_PASSWORD=secret
SMTP_FROM_EMAIL=kontakt@example.com
SMTP_TIMEOUT_SECONDS=30
SMTP_MESSAGE_ID_DOMAIN=example.com
SMTP_DEBUG_LEVEL=0

GMAIL_SMTP_USER=developer@gmail.com
GMAIL_SMTP_APP_PASSWORD=google-app-password
GMAIL_SMTP_PORT=587
GMAIL_SMTP_SECURE=tls
GMAIL_FROM_EMAIL=developer@example.com
GMAIL_MESSAGE_ID_DOMAIN=example.com
GMAIL_SMTP_TIMEOUT_SECONDS=30
TECHNICAL_EMAIL_WORKER_SLEEP_SECONDS=10
TECHNICAL_EMAIL_FALLBACK_TO_STANDARD=true
GMAIL_RATE_LIMIT_COUNT=450
GMAIL_RATE_LIMIT_WINDOW_MINUTES=1440

EMAIL_RATE_LIMIT_COUNT=100
EMAIL_RATE_LIMIT_WINDOW_MINUTES=15
EMAIL_RATE_LIMIT_RESERVATION_RETENTION_MINUTES=10080
EMAIL_ENQUEUE_RATE_LIMIT_COUNT=60
EMAIL_ENQUEUE_RATE_LIMIT_WINDOW_MINUTES=1
EMAIL_ENQUEUE_RATE_LIMIT_RETENTION_MINUTES=1440
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_SLEEP_SECONDS=10
EMAIL_WORKER_MAX_RUNTIME_SECONDS=0
WORKER_STOP_FILE=
EMAIL_PROCESSING_TIMEOUT_SECONDS=300
EMAIL_WORKER_LEASE_MIN_SECONDS=300
EMAIL_WORKER_HEARTBEAT_STALE_SECONDS=60
EMAIL_VALIDATE_RECIPIENT_MX=true
EMAIL_PRIORITY_AGING_SECONDS=900
EMAIL_BATCH_MAX_RECIPIENTS=1000
EMAIL_ATTACHMENT_MAX_COUNT=5
EMAIL_ATTACHMENT_MAX_TOTAL_BYTES=5000000
EMAIL_ATTACHMENT_ALLOWED_MIME_TYPES=image/png,application/pdf
EMAIL_MAX_QUEUED_PER_CLIENT=10000
EMAIL_MAX_ACTIVE_ATTACHMENT_BYTES_PER_CLIENT=100000000
EMAIL_DATA_RETENTION_DAYS=90

UNSUBSCRIBE_SECRET=replace-with-at-least-32-random-characters
UNSUBSCRIBE_SECRET_PREVIOUS=
UNSUBSCRIBE_MAILTO=
PUBLIC_BASE_URL=

DKIM_ENABLED=false
DKIM_DOMAIN=
DKIM_SELECTOR=mail
DKIM_PRIVATE_KEY_PATH=
DKIM_PASSPHRASE=

ALERT_EMAIL=
ALERT_WEBHOOK_URL=
ALERT_THROTTLE_SECONDS=3600
QUEUE_LATENCY_ALERT_SECONDS=900
MONITOR_FAILED_LOOKBACK_MINUTES=15

BOUNCE_IMAP_HOST=
BOUNCE_IMAP_PORT=993
BOUNCE_IMAP_FLAGS=/imap/ssl
BOUNCE_IMAP_USER=
BOUNCE_IMAP_PASSWORD=
