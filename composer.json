{
  "name": "central-mailer/smtp-service",
  "description": "Centralna usluga kolejkowanej wysylki e-mail przez SMTP.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "monolog/monolog": "^3.0",
    "phpmailer/phpmailer": "^6.9",
    "php-di/php-di": "^7.0",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "CentralMailer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CentralMailer\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S 0.0.0.0:8080 -t public public/router.php",
    "worker": "php bin/worker.php",
    "test": "phpunit"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5.50"
  }
}
